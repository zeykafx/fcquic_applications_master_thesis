// Note: This script was inspired by the evaluation script from Anthony Doeraene and NPF's documentation

%info
FCQUIC App Latency test

%config
n_runs=1
timeout=3600
result_append={LATENCY}

%late_variables
RELEASE_MODE=true
CONNECTION_SLEEP_LENGTH=2 // seconds to sleep before the clients consider the conn. to be open (TODO: must add a way to check the conn. status to fcquic)
BIN_LOG_LEVEL="trace"
PLOT_RESULTS=true

%variables
TOPO_CONF_NAME="medium_0%_loss"
NUM_CLIENTS=4
FALLBACK_DELAY=100
{
	FEC_MODE={"noredundancy", "constant", ""} 
	IS_BASELINE={"false","false","true"}
}
// This will 3 tests: FC-QUIC without FEC, FC-QUIC with FEC, Baseline QUIC (no FEC)
INTERVAL=1000
TEST_LENGTH=45
PER_CLIENT_LAT_RESULTS=false
WORKDIR=""
RUN_LOGS_DIR_BASELINE="./logs"
RUN_LOGS_DIR_FCQUIC_NO_FEC="./logs"
RUN_LOGS_DIR_FCQUIC_FEC="./logs"
CARGO_PATH=""

%init

# ------ Pre setup ------
# Setting buffer values
sudo sysctl -w net.core.rmem_max=26214400
sudo sysctl -w net.core.rmem_default=26214400


# ------------------------ Building App ------------------------

cd $WORKDIR
cd fcquic_chat

rm -rf $WORKDIR/evaluations/tests/latency/bin 2> /dev/null
mkdir $WORKDIR/evaluations/tests/latency/bin

echo "Building project"

if [ "$RELEASE_MODE" = "true" ]; then
    echo "building all in release mode"
    $CARGO_PATH build --release > /dev/null 2> /dev/null

   	cp ./target/release/quic-server $WORKDIR/evaluations/tests/latency/bin/quic-server
    cp ./target/release/quic-client $WORKDIR/evaluations/tests/latency/bin/quic-client
   	cp ./target/release/server $WORKDIR/evaluations/tests/latency/bin/server
    cp ./target/release/client $WORKDIR/evaluations/tests/latency/bin/client
else
    echo "building all in debug mode"
    $CARGO_PATH build > /dev/null 2> /dev/null

   	cp ./target/debug/quic-server $WORKDIR/evaluations/tests/latency/bin/quic-server
    cp ./target/debug/quic-client $WORKDIR/evaluations/tests/latency/bin/quic-client
   	cp ./target/debug/server $WORKDIR/evaluations/tests/latency/bin/server
    cp ./target/debug/client $WORKDIR/evaluations/tests/latency/bin/client
fi

echo "Done building project"

echo "copying certificates"
cp ./cert.crt $WORKDIR/evaluations/tests/latency/cert.crt
cp ./cert.key $WORKDIR/evaluations/tests/latency/cert.key


// ------------------------ Topology Setup ------------------------
%script@topology autokill=false sudo=true
cd $WORKDIR/evaluations/topologies

# Do not setup the topology if we're running the baseline test, or the fcquic test with FEC
# basically, only setup the topology before the very first test
# This is such a hack, but afaik there's no easy way to change a variable myself to know if the topo was setup already
# (the var change doesn't stick in between tests)
if [[ "$IS_BASELINE" == "true" || "$FEC_MODE" == "constant" ]]; then
	echo "Topo already setup, skipping setup"
else	
	echo "Setting up the topology"

	sudo python3 ./create-topo.py ./configs/latency/${TOPO_CONF_NAME}.yaml setup

	echo "Set up topologies, now waiting for convergence"

	# code from https://github.com/Aperence/FFSexp3-master-thesis/blob/57364d1b4244bb2c1c259dd4c41047670ab82b9a/evaluation/npfs/experiment.npf//L74

	CLIENT_ID_CONVERGENCE_TEST=$(echo ${NUM_CLIENTS} - 1 | bc)
	echo "Testing convergence from client${CLIENT_ID_CONVERGENCE_TEST}"

	converged=false
	while [ $converged != "true" ]; do
	    ping_res=$(ip netns exec client${CLIENT_ID_CONVERGENCE_TEST} ping 10.10.0.2 -i 0.1 -c 5)
	    errors=$(echo "$ping_res" | grep 'error')
	    losses=$(echo "$ping_res" | grep 'packet loss' | cut -f6 -d' ')
	    losses=${losses%\%}
	    if [ -z "$errors" -a "$losses" -lt 5 ]; then
	        converged=true
	    else
	        echo "Waiting for convergence"
	    fi
	done

	echo "Topology setup and IS-IS converged"

	# wait even more for everything to converge
	sleep 20
fi

echo "EVENT topo-setup"

// ------------------------ SERVER ------------------------
// Wait for the topology setup event to fire
%script@server waitfor=topo-setup

cd $WORKDIR/evaluations/tests/latency

echo "Starting server"

if [ "$IS_BASELINE" = "true" ]; then

	LOG_FILENAME=${RUN_LOGS_DIR_BASELINE}/server.log
	touch ${LOG_FILENAME}

	LOG_FILENAME=${RUN_LOGS_DIR_FCQUIC}/server.log

	sudo ip netns exec server1 env QLOGDIR=${RUN_LOGS_DIR_BASELINE} RUST_BACKTRACE=full RUST_LOG=${BIN_LOG_LEVEL} RUST_LOG_STYLE=always ./bin/quic-server \
		 --src 10.10.0.2:4433 --test-mode > ${LOG_FILENAME}  2>&1 &
else
	# Use different log directories for the FEC and NO FEC tests runs
	if [ "$FEC_MODE" = "constant" ]; then
		LOG_FILENAME=${RUN_LOGS_DIR_FCQUIC_FEC}/server.log
		echo "SERVER LOG FILENAME: ${LOG_FILENAME}"
		touch ${LOG_FILENAME}
	
		sudo ip netns exec server1 env QLOGDIR=${RUN_LOGS_DIR_FCQUIC_FEC} RUST_BACKTRACE=full RUST_LOG=${BIN_LOG_LEVEL} RUST_LOG_STYLE=always ./bin/server \
		 --src 10.10.0.2:4433 --mc-src-addr 10.10.0.2:4443 --test-mode --flexicast \
		 --fc-timer 0 --fall-back-delay $FALLBACK_DELAY --unicast --fec-scheduler ${FEC_MODE} > ${LOG_FILENAME}  2>&1 &	
	else	
		LOG_FILENAME=${RUN_LOGS_DIR_FCQUIC_NO_FEC}/server.log
		echo "SERVER LOG FILENAME: ${LOG_FILENAME}"
		touch ${LOG_FILENAME}
	
		sudo ip netns exec server1 env QLOGDIR=${RUN_LOGS_DIR_FCQUIC_NO_FEC} RUST_BACKTRACE=full RUST_LOG=${BIN_LOG_LEVEL} RUST_LOG_STYLE=always ./bin/server \
		 --src 10.10.0.2:4433 --mc-src-addr 10.10.0.2:4443 --test-mode --flexicast \
		 --fc-timer 0 --fall-back-delay $FALLBACK_DELAY --unicast --fec-scheduler ${FEC_MODE} > ${LOG_FILENAME}  2>&1 &
	fi

fi
echo "Server running!"

echo "EVENT server-up"

SLEEP_LENGTH_SERVER=$(echo "20+${TEST_LENGTH}" | bc)
echo "Server sleeping for ${SLEEP_LENGTH_SERVER}"
sleep ${SLEEP_LENGTH_SERVER}

// ------------------------ CLIENTS ------------------------
%script@client waitfor=server-up delay=2

cd $WORKDIR/evaluations/tests/latency

echo "Starting clients"
pids=()
for CLIENT_ID in $(seq $NUM_CLIENTS); do

		echo "starting client ${CLIENT_ID}"
    # run the client app in the client namespace
    # NOTE: redirect stdin from /dev/null and redirect stdout to logs/client{id}.log (but also redirect stdout to stdin with 2>&1, the log file in this case)
    CLIENT_ARGS=""
    if [ "$CLIENT_ID" = "1" ]; then
    		echo "client${CLIENT_ID} is the sender"
        CLIENT_ARGS="--sender"
    fi

    if [ "$PER_CLIENT_LAT_RESULTS" = "true" ]; then
   		CLIENT_ARGS="$CLIENT_ARGS --per-client-latency"
    fi

    if [ "$IS_BASELINE" = "true" ]; then

    	LOG_FILENAME=${RUN_LOGS_DIR_BASELINE}/client${CLIENT_ID}.log

			sudo ip netns exec client${CLIENT_ID} env QLOGDIR=${RUN_LOGS_DIR_BASELINE} RUST_BACKTRACE=full RUST_LOG=${BIN_LOG_LEVEL} RUST_LOG_STYLE=always ./bin/quic-client https://10.10.0.2:4433 \
				-u CLIENT${CLIENT_ID} --length $TEST_LENGTH \
				--test-mode ${CLIENT_ARGS} --conn-sleep-length ${CONNECTION_SLEEP_LENGTH} \
				--interval ${INTERVAL} < /dev/null 2> ${LOG_FILENAME} &
    else
    	if [ "$FEC_MODE" = "constant" ]; then
   			LOG_FILENAME=${RUN_LOGS_DIR_FCQUIC_FEC}/client${CLIENT_ID}.log
      	QLOGDIR=${RUN_LOGS_DIR_FCQUIC_FEC}
     	else
    		LOG_FILENAME=${RUN_LOGS_DIR_FCQUIC_NO_FEC}/client${CLIENT_ID}.log
     		QLOGDIR=${RUN_LOGS_DIR_FCQUIC_NO_FEC}
      fi

	    sudo ip netns exec client${CLIENT_ID} env QLOGDIR=${QLOGDIR} RUST_BACKTRACE=full RUST_LOG=${BIN_LOG_LEVEL} RUST_LOG_STYLE=always ./bin/client https://10.10.0.2:4433 \
				-l 10.10.${CLIENT_ID}.2 --flexicast -u CLIENT${CLIENT_ID} --length $TEST_LENGTH \
				--test-mode ${CLIENT_ARGS} --conn-sleep-length ${CONNECTION_SLEEP_LENGTH} \
				--interval ${INTERVAL} < /dev/null 2> ${LOG_FILENAME} &
		fi

    # store the pid of this client into the pids set
    pids[${CLIENT_ID}]=$!
done

echo "All clients started"

# wait for all clients to finish
for pid in ${pids[*]}; do
    wait $pid
done

echo "EVENT clients-done"

# only output the tests-done event when the baseline clients are done
if [ "$IS_BASELINE" = "true" ]; then
	echo "EVENT tests-done"
fi


// can't graph here because the csv hasn't been saved yet lol....
// %script@plotting waitfor=tests-done
// // ------------------------ PLOTS ------------------------

// echo "Graphing results"

// cd $WORKDIR/evaluations/tests/latency/graphs

// ./cdf_plots.py ../out/npf_out.csv --name ${TOPO_CONF_NAME}

// echo "EVENT plotting-done"

%script@teardown waitfor=tests-done

cd $WORKDIR/evaluations/topologies
echo "Tearing down the topology ${TOPO_CONF_NAME}"
sudo python3 ./create-topo.py ./configs/latency/${TOPO_CONF_NAME}.yaml teardown

echo "EVENT topo-teardown"
