# Note: This script was inspired by the evaluation script from Anthony Doeraene and NPF's documentation

%info
FCQUIC App Latency test


%config
n_runs=1
timeout=3600

%late_variables
RELEASE_MODE=true
WORKDIR=$(pwd)
TOPO_FILE="$WORKDIR/topologies/configs/latency/topo.yaml"
connection_sleep_length=2 # seconds to sleep before the clients consider the conn. to be open (TODO: must add a way to check the conn. status to fcquic)

%variables
fallback_delay=100
num_clients=20
test_length=30 # in seconds

%init
# ------------------------ Building App ------------------------
cd $WORKDIR
cd ../fcquic_chat

if [ "$RELEASE_MODE" = true ]; then
    echo "building all in release mode"
    cargo build --release > /dev/null 2> /dev/null

    cp ./target/release/server $WORKDIR/tests/latency/server
    cp ./target/release/client $WORKDIR/tests/latency/client
else
    echo "building all in debug mode"
    cargo build > /dev/null 2> /dev/null

    cp ./target/debug/server $WORKDIR/tests/latency/server
    cp ./target/debug/client $WORKDIR/tests/latency/client
fi


# ------------------------ Topology Setup ------------------------
%script@topology autokill=false
cd $WORKDIR/topologies

python3 ./create-topo.py $TOPO_FILE setup

converged=false
while [ $converged=false ]; do
    # code from https://github.com/Aperence/FFSexp3-master-thesis/blob/57364d1b4244bb2c1c259dd4c41047670ab82b9a/evaluation/npfs/experiment.npf#L74
    ping_res=$(ip netns exec client1 ping 10.10.0.2 -i 0.1 -c 5)
    errors=$(echo "$ping_res" | grep 'error')
    losses=$(echo "$ping_res" | grep 'packet loss' | cut -f6 -d' ')
    losses=${losses%\%}
    if [ -z "$errors" -a "$losses" -lt 5 ]; then
        converged=true
    else
        echo "Waiting for convergence"
    fi
done

echo "Topology setup and IS-IS converged"
echo "EVENT topo-setup"

# ------------------------ SERVER ------------------------
# Wait for the topology setup event to fire
%script@server waitfor=topo-setup

cd $WORKDIR/tests/latency

sudo ip netns exec server1 server \
 --src 10.10.0.2:4433 --mc-src-addr 10.10.0.2:4443 --flexicast \
 --fc-timer 0 --ctl-ack-delay 0 --fall-back-delay $fallback_delay --unicast

echo "EVENT server-up"


# ------------------------ CLIENTS ------------------------
%script@server waitfor=server-up delay=1 autokill=false

cd $WORKDIR/tests/Latency
mkdir logs

pids=()
for CLIENT_ID in $(seq $num_clients); do 
    # run the client app in the client namespace
    # NOTE: redirect stdin from /dev/null and redirect stdout to logs/client{id}.log
    client_sender_arg=""
    if [ "$CLIENT_ID" == "1" ]; then
        client_sender_arg="--sender"
    fi
    ip netns exec client${CLIENT_ID} client https://10.10.0.2:4433 \
    -l 10.10.${CLIENT_ID}.2 --flexicast -u Client${CLIENT_ID} --length $test_length --test-mode ${client_test_args} --connection_sleep_length ${connection_sleep_length} < /dev/nul 2> logs/client${CLIENT_ID}.log & 
    
    # store the pid of this client into the pids set
    pids[${CLIENT_ID}]=$!
done


# wait for all clients to finish
for pid in ${pids[*]}; do
    wait $pid
done

echo "EVENT clients-done" 
