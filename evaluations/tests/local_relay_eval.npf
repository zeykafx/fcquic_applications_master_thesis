// # Note: This script was inspired by the evaluation script from Anthony Doeraene, as well as the following scripts from the FCQUIC's repo
// # - https://github.com/IPNetworkingLab/flexicast-quic/blob/1e53ef9488dd9260a6c1f966f08b83db526974cc/experiments/scaling/scaling.npf
// # - https://github.com/IPNetworkingLab/flexicast-quic/blob/1e53ef9488dd9260a6c1f966f08b83db526974cc/experiments/robustness/robustness.npf

%info
FCQUIC emulated relay eval

%config
n_runs=3
n_supplementary_runs=0
timeout=40
result_append={LATENCY}

%late_variables
CONNECTION_SLEEP_LENGTH=2
BIN_LOG_LEVEL="info"
client_log_dir="/home/corentin/fcquic_applications_master_thesis/evaluations/tests/local_relay_eval/logs/client"
server_log_dir="/home/corentin/fcquic_applications_master_thesis/evaluations/tests/local_relay_eval/logs/server"
relay_log_dir="/home/corentin/fcquic_applications_master_thesis/evaluations/tests/local_relay_eval/logs/relay"
READY_SLEEP_RELAY=1

%variables
// # ------------- Base test: No relay vs fcquic relay vs app relay -------------
LAMBDA=100
TEST_LENGTH=20
ADDITIONAL_DATA_SIZE=1100
RELAY_VERSION={"RELAY","APP_RELAY","none"}
// # ------------- additional data test -------------
data:LAMBDA=50
data:ADDITIONAL_DATA_SIZE={1100,2200}
data:RELAY_VERSION={"RELAY","APP_RELAY","none"}
// # ------------- Other vars -------------
FALLBACK_DELAY=1000
POISSON="true"
INTERVAL=100
CC_ALGO="disabled"
USE_SYSTEM_TIME="true"
PER_CLIENT_LAT_RESULTS="false"
NUM_NS_PER_CLIENT=5
RELAY_IPS="empty"
RUN_LOGS_DIR_RELAY="./logs"
RUN_LOGS_DIR_SERVER="./logs"
RUN_LOGS_DIR_APP_RELAY="./logs"
WORKDIR=""
CARGO_PATH=""

%init

# ------ Pre setup ------
# Setting buffer values
sudo sysctl -w net.core.rmem_max=26214400
sudo sysctl -w net.core.rmem_max=26214400

# ------------------------ Building App ------------------------

cd $WORKDIR

rm -rf $WORKDIR/evaluations/tests/local_relay_eval/bin 2> /dev/null
mkdir -p $WORKDIR/evaluations/tests/local_relay_eval/bin

cd fcquic_relay
echo "Building project"
$CARGO_PATH build --release > /dev/null

cp ./target/release/server $WORKDIR/evaluations/tests/local_relay_eval/bin/server
cp ./target/release/client $WORKDIR/evaluations/tests/local_relay_eval/bin/client
cp ./target/release/fcquic_relay $WORKDIR/evaluations/tests/local_relay_eval/bin/fcquic_relay
cp ./target/release/app_relay $WORKDIR/evaluations/tests/local_relay_eval/bin/app_relay
echo "Done building project"

echo "copying certificates"
cp ./cert.crt $WORKDIR/evaluations/tests/local_relay_eval/cert.crt
cp ./cert.key $WORKDIR/evaluations/tests/local_relay_eval/cert.key


// ------------------------ SERVER ------------------------
%script@server


echo "Starting server"

pkill server || true

SERVER_QLOG_DIR=${server_log_dir}/${RELAY_VERSION}
mkdir -p $SERVER_QLOG_DIR

SERVER_EXEC="env QLOGDIR=${SERVER_QLOG_DIR} RUST_LOG_STYLE=never RUST_BACKTRACE=full RUST_LOG=${BIN_LOG_LEVEL} ${SERVER_BIN_PATH}"

TEST_LENGTH_SERVER=$(echo "5+${TEST_LENGTH}" | bc)

${SERVER_EXEC} \
--src 10.10.0.2:4433 --mc-src-addr 10.10.0.2:4443 --test-mode --flexicast \
--fc-timer 0 --fall-back-delay $FALLBACK_DELAY --unicast --fec-scheduler noredundancy --length ${TEST_LENGTH_SERVER} --cc-algorithm ${CC_ALGO} --fc-cwnd ${CC_ALGO} > $server_log_dir/server.log 2>&1 &

echo "Server running!"
sleep $TEST_LENGTH_SERVER

// ------------------------ RELAY ------------------------
%script@relay

pkill app_relay || true
pkill fcquic_relay || true

TEST_LENGTH_RELAY=$(echo "5+${TEST_LENGTH}" | bc)

// give time to the server
sleep "${READY_SLEEP_RELAY}"

if [ "${RELAY_VERSION}" = "none" ]; then
    echo "not testing with relays"
    sleep $TEST_LENGTH_RELAY
else

    CURRENT_RELAY_IP=$(ip -f inet addr show | grep inet | tail -1 | awk '{print $2}' | cut -d'/' -f1)

    echo "Starting relay ${NPF_NODE_ID} at ${CURRENT_RELAY_IP}"

    if [ "${RELAY_VERSION}" = "RELAY" ]; then
        echo "Using fcquic relay"
        RELAY_BIN_PATH="WORKDIR/evaluations/tests/local_relay_eval/bin/fcquic_relay"
    elif [ "${RELAY_VERSION}" = "APP_RELAY" ]; then
        echo "Using app relay"
        RELAY_BIN_PATH="WORKDIR/evaluations/tests/local_relay_eval/bin/app_relay"
    else
        echo "unknown RELAY_VERSION=${RELAY_VERSION}" >&2
        exit 1
    fi


    env RUST_LOG_STYLE=never RUST_BACKTRACE=full QLOGDIR=${relay_log_dir} RUST_LOG=${BIN_LOG_LEVEL} ${RELAY_BIN_PATH} \
        https://${SERVER_IP}:4433 \
        --src ${CURRENT_RELAY_IP}:4433 \
        --mc-src-addr ${CURRENT_RELAY_IP}:4443 \
        --test-mode --flexicast \
        --length ${TEST_LENGTH_RELAY} \
        --fc-timer 0 --fall-back-delay $FALLBACK_DELAY --unicast \
        --fec-scheduler noredundancy \
        --cc-algorithm ${CC_ALGO} --fc-cwnd ${CC_ALGO} \
        > ${relay_log_dir}/relay_${NPF_NODE_ID}.log 2>&1 &

    echo "Relay ${NPF_NODE_ID} running at ${CURRENT_RELAY_IP}!"
    sleep $TEST_LENGTH_RELAY
fi

// ------------------------ CLIENTS ------------------------
// # clients connect to the relay in their cluster when USE_RELAY=true, otherwise directly to the server
%script@client delay=1

echo "Starting clients on node ${NPF_NODE_ID} (${NUM_NS_PER_CLIENT} namespaces)"

pkill client || true

base_exec="env RUST_LOG_STYLE=never RUST_BACKTRACE=full RUST_LOG=${BIN_LOG_LEVEL} ${CLIENT_BIN_PATH}"



pids=()
// # loop over each namespace on this node
for NS_IDX in $(seq $(echo "${NUM_NS_PER_CLIENT} - 1" | bc) -1 0); do


    // # global client ID = (node_id * num_ns) + ns_idx; +1 
    GLOBAL_IDX=$(echo "${NPF_NODE_ID}*${NUM_NS_PER_CLIENT}" + ${NS_IDX} | bc)
    CLIENT_ID=$(echo "${GLOBAL_IDX} +1" | bc)
    NS_NAME="client-${NS_IDX}"

    CLIENT_IP=$(ip netns exec $NS_NAME ip -f inet addr show | grep inet | tail -1 | awk '{print $2}' | cut -d'/' -f1)

    echo "Client ID: ${CLIENT_ID} (ns=${NS_NAME}) has IP: ${CLIENT_IP}"

    CLIENT_ARGS="-u CLIENT${CLIENT_ID} --length $TEST_LENGTH --test-mode --conn-sleep-length ${CONNECTION_SLEEP_LENGTH} --interval ${INTERVAL} --additional-data-size ${ADDITIONAL_DATA_SIZE} --cc-algorithm ${CC_ALGO}"

    CLIENT_ARGS="$CLIENT_ARGS --show-own-messages"

    if [ "$CLIENT_ID" = "1" ]; then
        echo "client${CLIENT_ID} is the sender"
        CLIENT_ARGS="$CLIENT_ARGS --sender"
    fi

    if [ "$PER_CLIENT_LAT_RESULTS" = "true" ]; then
        CLIENT_ARGS="$CLIENT_ARGS --per-client-latency"
    fi

    if [ "$POISSON" = "true" ]; then
        CLIENT_ARGS="$CLIENT_ARGS --poisson --lambda ${LAMBDA}"
    fi
    if [ "$USE_SYSTEM_TIME" = "true" ]; then
        CLIENT_ARGS="$CLIENT_ARGS --use-system-time"
    fi

    // for the test without relays, we'll just pass in an empty string so that the clients connect to the server
    CLEAN_RELAY_IPS=""
    if [ "$RELAY_VERSION" != "none" ]; then
        IFS=' ' read -ra RELAY_IPS_ARR <<< "$RELAY_IPS"
        for i in "${RELAY_IPS_ARR[@]}"; do
            CLEAN_RELAY_IPS="${CLEAN_RELAY_IPS} --relay-ips=${i}"
        done
    fi

    // # run the client inside its network namespace
    ip netns exec $NS_NAME $base_exec --server-ip ${SERVER_IP} --port 4433 ${CLEAN_RELAY_IPS} \
    -l $CLIENT_IP --flexicast ${CLIENT_ARGS} < /dev/null 2> $client_log_dir/client_${CLIENT_ID}.log &

    pids+=($!)
done

// # wait for all clients on this node to finish
for pid in "${pids[@]}"; do
    wait $pid
done

