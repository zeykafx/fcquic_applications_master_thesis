// # Note: This script was inspired by the evaluation script from Anthony Doeraene, as well as the following scripts from the FCQUIC's repo
// # - https://github.com/IPNetworkingLab/flexicast-quic/blob/1e53ef9488dd9260a6c1f966f08b83db526974cc/experiments/scaling/scaling.npf
// # - https://github.com/IPNetworkingLab/flexicast-quic/blob/1e53ef9488dd9260a6c1f966f08b83db526974cc/experiments/robustness/robustness.npf

%info
FCQUIC vs QUIC vs TCP (with TLS)

%config
n_runs=1
n_supplementary_runs=0
timeout=3600
result_append={LATENCY}

%late_variables
CONNECTION_SLEEP_LENGTH=1
BIN_LOG_LEVEL="info"
tcpdump_dir="/home/cdetry/"
client_log_dir="/home/cdetry/logs/client"
server_log_dir="/home/cdetry/logs/server"
relay_log_dir="/home/cdetry/logs/relay"

%variables
INTERVAL=100
LAMBDA=0.001
TEST_LENGTH=20
FALLBACK_DELAY=1000
// # ADDITIONAL_DATA_SIZE={0,500,1100}
ADDITIONAL_DATA_SIZE=1100
USE_RELAY={"true","false"}
RELAY_VERSION={"RELAY","APP_RELAY"}
POISSON="true"
CC_ALGO="disabled"
USE_SYSTEM_TIME="true"
PER_CLIENT_LAT_RESULTS="false"

NUM_NS_PER_CLIENT=5
SERVER_IP=""
CLIENT_IPS="empty"
RELAY_IPS="empty"
SERVER_PROD_IFACE="empty"
TCPDUMP=1

USE_DOCKER="false"

SERVER_BIN_PATH="/home/cdetry/bin/server"
CLIENT_BIN_PATH="/home/cdetry/bin/client"

// # %init@server
// # sudo sysctl -w net.core.rmem_max=26214400
// # sudo sysctl -w net.core.rmem_default=26214400

// # %init@client
// # sudo sysctl -w net.core.rmem_max=26214400
// # sudo sysctl -w net.core.rmem_default=26214400


%import@server cpuload CPUSUM=1

// ------------------------ SERVER ------------------------
%script@server

echo "Starting server with IP $SERVER_IP"

if [ "$USE_DOCKER" = "true" ]; then
    SERVER_IMAGE="corentindetry/fcquic_server"
    SERVER_EXEC="docker run --network=host \
            --privileged \
            -v ${WORKDIR}:${WORKDIR} \
            -e RUST_LOG_STYLE=always \
            -e RUST_BACKTRACE=full \
            -e RUST_LOG=${BIN_LOG_LEVEL} \
            ${SERVER_IMAGE}"
else
    SERVER_EXEC="env RUST_LOG_STYLE=always RUST_BACKTRACE=full QLOGDIR=${server_log_dir} RUST_LOG=${BIN_LOG_LEVEL} ${SERVER_BIN_PATH}"
fi

TEST_LENGTH_SERVER=$(echo "5+${TEST_LENGTH}" | bc)

${SERVER_EXEC} \
--cert-path /home/cdetry \
--src ${SERVER_IP}:4433 --mc-src-addr ${SERVER_IP}:4443 --test-mode --flexicast \
--fc-timer 0 --fall-back-delay $FALLBACK_DELAY --unicast --fec-scheduler noredundancy --length ${TEST_LENGTH_SERVER} --cc-algorithm ${CC_ALGO} --fc-cwnd ${CC_ALGO} > $server_log_dir/server.log 2>&1 &

echo "Server running!"
sleep $TEST_LENGTH_SERVER

// ------------------------ RELAY ------------------------
%script@relay delay=1

if [ "$USE_RELAY" != "true" ]; then
    echo "not testing with relays"
    sleep $(echo "5+${TEST_LENGTH}" | bc)
fi

CURRENT_RELAY_IP=${RELAY_IPS[$NPF_NODE_ID]}
TEST_LENGTH_SERVER=$(echo "5+${TEST_LENGTH}" | bc)

echo "Starting relay ${NPF_NODE_ID} at ${CURRENT_RELAY_IP}, connecting to ${SERVER_IP}"


if [ "$RELAY_VERSION" = "RELAY" ]; then
    echo "Using fcquic relay"
    RELAY_BIN_PATH="/home/cdetry/bin/relay"
else
    echo "Using app relay"
    RELAY_BIN_PATH="/home/cdetry/bin/app_relay"
else
fi

env RUST_LOG_STYLE=always RUST_BACKTRACE=full RUST_LOG=${BIN_LOG_LEVEL} ${RELAY_BIN_PATH} \
    https://${SERVER_IP}:4433 \
    --src ${CURRENT_RELAY_IP}:4433 \
    --mc-src-addr ${CURRENT_RELAY_IP}:4443 \
    --cert-path /home/cdetry \
    --test-mode --flexicast \
    --fc-timer 0 --fall-back-delay $FALLBACK_DELAY --unicast \
    --fec-scheduler noredundancy \
    --cc-algorithm ${CC_ALGO} --fc-cwnd ${CC_ALGO} \
    > ${relay_log_dir}/relay_${NPF_NODE_ID}.log 2>&1 &

echo "Relay ${NPF_NODE_ID} running at ${CURRENT_RELAY_IP}!"
sleep $TEST_LENGTH_RELAY

// ------------------------ CLIENTS ------------------------
// # clients connect to the relay in their cluster when USE_RELAY=true, otherwise directly to the server
%script@client delay=1

echo "Starting clients on node ${NPF_NODE_ID} (${NUM_NS_PER_CLIENT} namespaces)"

pids=()
ips=$CLIENT_IPS

if [ "$USE_DOCKER" = "true" ]; then
    CLIENT_IMAGE="corentindetry/fcquic_client"
    base_exec="docker run --network=host \
            --privileged \
            -v ${WORKDIR}:${WORKDIR} \
            -e RUST_LOG_STYLE=always \
            -e RUST_BACKTRACE=full \
            -e RUST_LOG=${BIN_LOG_LEVEL} \
            ${CLIENT_IMAGE}"
else
    base_exec="env RUST_LOG_STYLE=always RUST_BACKTRACE=full RUST_LOG=${BIN_LOG_LEVEL} ${CLIENT_BIN_PATH}"
fi

// # loop over each namespace on this node
# for NS_IDX in $(seq $(echo "${NUM_NS_PER_CLIENT} - 1" | bc) -1 0); do

    CLIENT_ID=${NPF_NODE_ID}
    NS_NAME="client-${CLIENT_ID}"

    CLIENT_IP=$(ip netns exec $NS_NAME ip -f inet addr show | grep inet | tail -1 | awk '{print $2}' | cut -d'/' -f1)
    # CLIENT_IP=${ips[$GLOBAL_IDX]}

    echo "Client ID: ${CLIENT_ID} (ns=${NS_NAME}) has IP: ${CLIENT_IP}"

    CLIENT_ARGS="-u CLIENT${CLIENT_ID} --length $TEST_LENGTH --test-mode --conn-sleep-length ${CONNECTION_SLEEP_LENGTH} --interval ${INTERVAL} --own-ip ${CLIENT_IP} --additional-data-size ${ADDITIONAL_DATA_SIZE} --cc-algorithm ${CC_ALGO}"

    CLIENT_ARGS="$CLIENT_ARGS --show-own-messages"

    if [ "$CLIENT_ID" = "1" ]; then
        echo "client${CLIENT_ID} is the sender"
        CLIENT_ARGS="$CLIENT_ARGS --sender"
    fi

    if [ "$PER_CLIENT_LAT_RESULTS" = "true" ]; then
        CLIENT_ARGS="$CLIENT_ARGS --per-client-latency"
    fi

    if [ "$POISSON" = "true" ]; then
        CLIENT_ARGS="$CLIENT_ARGS --poisson --lambda ${LAMBDA}"
    fi
    if [ "$USE_SYSTEM_TIME" = "true" ]; then
        CLIENT_ARGS="$CLIENT_ARGS --use-system-time"
    fi


    // # run the client inside its network namespace
    // # NOTE: the RELAY_IPS variable contains the "--relay-ips=" argument between each ip, so we omit it here
    ip netns exec $NS_NAME $base_exec --server-ip ${SERVER_IP} --port 4433 ${RELAY_IPS} \
    -l $CLIENT_IP --flexicast ${CLIENT_ARGS} < /dev/null 2> $client_log_dir/client_${CLIENT_ID}.log &
    wait

    # pids[${CLIENT_ID}]=$!
# done

// # wait for all clients on this node to finish
# for pid in ${pids[*]}; do
#     wait $pid
# done
