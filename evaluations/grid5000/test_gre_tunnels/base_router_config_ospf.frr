frr defaults traditional
!
ip forwarding
!
ip prefix-list multicast permit 224.0.0.0/4

ip prefix-list ospf_out seq 5 deny 172.16.0.0 ge 16 le 22 
ip prefix-list ospf_out seq 10 permit any

!
! ip route 0.0.0.0/0 {{ gateway }} 250
ip route 172.16.0.0/16 {{ gateway }} 1
!
interface lo
    ip address {{ lo_address }}/32
    ip igmp
    ip pim
    ! ip ospf area 0
    ip igmp immediate-leave
!
interface {{ prod_iface }}
    ip address {{ prod_net_ip }}/24
    ip pim
    ip igmp
    ip igmp immediate-leave
    ! ip ospf area 0 ! Don't use this line when using the network xyz commands otherwise those don't apply and the prefix list doesn't either
    ip ospf passive
!
interface gre1
    ip address 192.168.0.{{ tunnel_node_id }}/30
    ip pim
    ip igmp
    ip igmp immediate-leave
    ! ip ospf area 0
    ip ospf network point-to-point
    tunnel source {{ prod_iface }}
!
router pim
    ssm prefix-list multicast
!
router ospf
    ospf router-id {{ router_id }}
    network {{ prod_network }}/24 area 0
    network 192.168.0.{{ tunnel_node_id }}/30 area 0
    network {{ lo_address }}/32 area 0
    area 0 export-list ospf_out
!
line vty
!
